# Copy to .env and fill in your values. Never commit .env.

# Primary: read-write
POSTGRES_HOST=your-primary.postgres.database.azure.com

# Read replica: read-only. Leave empty in local dev to send everything to POSTGRES_HOST
POSTGRES_REPLICA_HOST=your-replica.postgres.database.azure.com

# App login, shared by both servers (the replica copies the primary's users and passwords)
POSTGRES_USER=your_app_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database

# true = connect through Azure's built-in PgBouncer (port 6432); enable pgbouncer.enabled on BOTH servers first
POSTGRES_PGBOUNCER=true

# Ports: 6432 = PgBouncer, 5432 = Postgres directly. Default: 6432 if POSTGRES_PGBOUNCER=true, else 5432
POSTGRES_PORT=6432
POSTGRES_REPLICA_PORT=6432

# ── Connection pool (per app instance) ──────────────────────────────────────
# Max connections: primary (writes) and replica (reads; usually ~80% of traffic, so larger).
# Through PgBouncer these are cheap client connections; real server connections are
# capped by pgbouncer.default_pool_size on each server.
POSTGRES_POOL_MAX=10
POSTGRES_REPLICA_POOL_MAX=20
# Connections kept open when idle, so the first queries after a quiet period skip the TLS handshake
POSTGRES_POOL_MIN=2
# Close connections above POOL_MIN after this much idle time
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
# Max wait for a free/new connection. Hitting it = pool saturated (raise POOL_MAX or fix slow queries)
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000
# Recycle each connection after this long, so connections rebalance after failover/scaling
POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800

# ── Timeouts ────────────────────────────────────────────────────────────────
# Client-side: app gives up waiting for a query (keep above statement_timeout)
POSTGRES_QUERY_TIMEOUT_MS=35000
# Server-side kill of long queries. Only used when POSTGRES_PGBOUNCER=false;
# with PgBouncer set it on the database user instead (ALTER ROLE ... SET statement_timeout, see sql/setup.sql)
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# ── Replica health ──────────────────────────────────────────────────────────
# Reads move from replica to primary while replica lag exceeds this
POSTGRES_MAX_REPLICA_LAG_SECONDS=5
# How often replica lag/health is checked
POSTGRES_HEALTH_CHECK_INTERVAL_MS=15000

# Shows up in pg_stat_activity, so you can tell which app owns a connection
APP_NAME=your-app-name
